#. module: eh_access_studio
#: model:res.groups,comment:eh_access_studio.group_eh_access_manager
msgid ""
"\n"
"                Full access to Access Studio. Can create, edit and deactivate\n"
"                profiles. Implies Access Studio User.\n"
"            "
msgstr ""
"\n"
"Access Studio तक पूर्ण पहुँच। प्रोफ़ाइल बना सकते हैं, संपादित कर सकते हैं और निष्क्रिय कर सकते हैं।\n"
"                इसमें Access Studio User शामिल है।"

#. module: eh_access_studio
#: model:res.groups,comment:eh_access_studio.group_eh_access_user
msgid ""
"\n"
"                Read-only access to the Access Studio configuration. Users in\n"
"                this group can view profiles and rule lines but cannot edit\n"
"                them.\n"
"            "
msgstr ""
"\n"
"Access Studio कॉन्फ़िगरेशन तक केवल-पढ़ने की पहुँच। इस समूह के\n"
"                उपयोगकर्ता प्रोफ़ाइल और नियम पंक्तियाँ देख सकते हैं लेकिन उन्हें संपादित नहीं कर सकते।"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid ""
"\n"
"... and %(extra)s more."
msgstr ""
"\n"
"... और %(extra)s अन्य।"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid "%(n)s active profile(s) have no rules (no-op): %(names)s"
msgstr ""
"%(n)s सक्रिय प्रोफ़ाइल में कोई नियम नहीं है (कोई कार्रवाई नहीं): %(names)s"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid "%(n)s active profile(s) have no users assigned: %(names)s"
msgstr ""
"%(n)s सक्रिय प्रोफ़ाइल में कोई उपयोगकर्ता असाइन नहीं किया गया: %(names)s"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid ""
"%(n)s active profile(s) past their Active Until date (cron has not "
"deactivated them yet): %(names)s"
msgstr ""
"%(n)s सक्रिय प्रोफ़ाइल अपनी 'सक्रिय तक' तिथि पार कर चुके हैं (cron ने अभी तक"
" उन्हें निष्क्रिय नहीं किया है): %(names)s"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid "%(n)s company / companies"
msgstr "%(n)s कंपनी/कंपनियाँ"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid ""
"%(n)s conflict(s) detected:\n"
"\n"
"%(list)s%(tail)s\n"
"\n"
"Resolution: deactivate one of the profiles, or align their domain filters so they describe the same record set."
msgstr ""
"%(n)s विरोध का पता चला:\n"
"\n"
"%(list)s%(tail)s\n"
"\n"
"समाधान: प्रोफ़ाइल में से किसी एक को निष्क्रिय करें, या उनके डोमेन फ़िल्टर को संरेखित करें ताकि वे समान रिकॉर्ड सेट का वर्णन करें।"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
msgid ""
"%(n)s domain rule(s) cannot be parsed and will fail closed at runtime. "
"Profiles affected: %(names)s"
msgstr ""
"%(n)s डोमेन नियम को पार्स नहीं किया जा सकता और रनटाइम पर बंद अवस्था में विफल"
" होंगे। प्रभावित प्रोफ़ाइल: %(names)s"

