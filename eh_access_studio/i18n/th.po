"%(name)s applies to %(users)s user(s) under %(scope)s.\n"
"\n"
"%(body)s"
msgstr ""
"%(name)s ใช้กับผู้ใช้ %(users)s รายภายใต้ %(scope)s\n"
"\n"
"%(body)s"

#. module: eh_access_studio
#. odoo-python
#: code:addons/eh_access_studio/models/eh_access_profile.py:0
