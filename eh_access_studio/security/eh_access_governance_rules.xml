<odoo>
  <record id="rule_eh_access_role_company" model="ir.rule"><field name="name">Access roles: permitted companies</field><field name="model_id" ref="model_eh_access_role"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_eh_access_assignment_company" model="ir.rule"><field name="name">Access assignments: permitted companies</field><field name="model_id" ref="model_eh_access_assignment"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_eh_access_request_company" model="ir.rule"><field name="name">Access requests: permitted companies</field><field name="model_id" ref="model_eh_access_request"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_eh_access_audit_company" model="ir.rule"><field name="name">Access evidence: permitted companies</field><field name="model_id" ref="model_eh_access_audit"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_eh_access_assignment_own" model="ir.rule"><field name="name">Access assignments: own</field><field name="model_id" ref="model_eh_access_assignment"/><field name="groups" eval="[(4, ref('base.group_user'))]"/><field name="domain_force">[('user_id', '=', user.id)]</field></record>
  <record id="rule_eh_access_request_own" model="ir.rule"><field name="name">Access requests: own</field><field name="model_id" ref="model_eh_access_request"/><field name="groups" eval="[(4, ref('base.group_user'))]"/><field name="domain_force">[('user_id', '=', user.id)]</field></record>
  <record id="rule_eh_access_assignment_manager" model="ir.rule"><field name="name">Access assignments: manager</field><field name="model_id" ref="model_eh_access_assignment"/><field name="groups" eval="[(4, ref('eh_access_studio.group_eh_access_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="rule_eh_access_request_manager" model="ir.rule"><field name="name">Access requests: manager</field><field name="model_id" ref="model_eh_access_request"/><field name="groups" eval="[(4, ref('eh_access_studio.group_eh_access_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>
