<odoo>
    <data>

        <record id="group_eh_access_user" model="res.groups">
            <field name="name">Access Studio: User</field>
            <field name="comment">
                Read-only access to the Access Studio configuration. Users in
                this group can view profiles and rule lines but cannot edit
                them.
            </field>
        </record>

        <record id="group_eh_access_manager" model="res.groups">
            <field name="name">Access Studio: Manager</field>
            <field name="comment">
                Full access to Access Studio. Can create, edit and deactivate
                profiles. Implies Access Studio User.
            </field>
            <field name="implied_ids" eval="[(4, ref('eh_access_studio.group_eh_access_user'))]"/>
        </record>

        <!--
            System administrators (base.group_system) automatically get
            Access Studio Manager rights. The (4, ...) append-mode is
            used so we extend the implied_ids list without dropping any
            other module's additions.
        -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('eh_access_studio.group_eh_access_manager'))]"/>
        </record>

    </data>
</odoo>
