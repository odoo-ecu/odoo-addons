<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eh_access_audit_list" model="ir.ui.view">
        <field name="name">eh.access.audit.list</field>
        <field name="model">eh.access.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="occurred_at"/>
                <field name="event"/>
                <field name="actor_id"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="resource_name"/>
                <field name="resource_model" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_eh_access_audit_form" model="ir.ui.view">
        <field name="name">eh.access.audit.form</field>
        <field name="model">eh.access.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="event"/><field name="occurred_at"/><field name="actor_id"/><field name="user_id"/></group>
                        <group><field name="company_id"/><field name="resource_name"/><field name="resource_model"/><field name="resource_id"/></group>
                    </group>
                    <group string="Change Details"><field name="details" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_eh_access_audit_search" model="ir.ui.view">
        <field name="name">eh.access.audit.search</field>
        <field name="model">eh.access.audit</field>
        <field name="arch" type="xml">
            <search><field name="event"/><field name="actor_id"/><field name="user_id"/><field name="resource_name"/><filter name="actor" string="Actor" context="{'group_by': 'actor_id'}"/><filter name="event" string="Event" context="{'group_by': 'event'}"/></search>
        </field>
    </record>
    <record id="action_eh_access_audit" model="ir.actions.act_window">
        <field name="name">Governance Audit</field>
        <field name="res_model">eh.access.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
