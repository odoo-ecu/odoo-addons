<odoo>
    <data noupdate="0">

        <record id="rule_stock_picking_allowed_locations" model="ir.rule">
            <field name="name">Restricted Stock Picking Access</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">
                [
                    '&amp;',
                        '|',
                            ('location_id', 'child_of', user.allowed_location_ids.ids),
                            ('location_dest_id', 'child_of', user.allowed_location_ids.ids),
                        '&amp;',
                            '!',
                            ('location_id', 'child_of', user.not_allowed_transfer_location_ids.ids),
                            '!',
                            ('location_dest_id', 'child_of', user.not_allowed_transfer_location_ids.ids)
                ]
            </field>
            <field name="groups" eval="[(4, ref('group_restricted_warehouse_user'))]"/>
        </record>

    </data>
</odoo>